# AICTE FlowOps Frontend — Environment Variables
# Copy this file to .env or .env.local for local overrides.

# Backend API base URL (leave empty to use relative /api reverse proxy in development)
# In production on Vercel, set this to your deployed backend URL:
# VITE_API_BASE_URL=https://aicte-flowops-api.onrender.com
VITE_API_BASE_URL=

# Google Authentication Client ID (optional in development; when omitted, demo Google picker is active)
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

