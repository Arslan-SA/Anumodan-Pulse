# AICTE FlowOps Backend — Environment Variables Configuration
# Copy this file to .env and configure for your deployment environment.

# ── Database ────────────────────────────────────────────────────────────
# PostgreSQL connection string. Supports postgresql:// and postgres:// (auto-normalized)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aicte_flowops

# ── Application Environment ─────────────────────────────────────────────
# Set to 'production' in deployed environments (disables debug, enforces 32+ char secret)
APP_ENV=development
DEBUG=true

# ── CORS Settings ───────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Server Binding ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Authentication / JWT ────────────────────────────────────────────────
# Must be at least 32 characters in production
JWT_SECRET_KEY=aicte-flowops-development-secret-key-at-least-32-chars-long-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Storage Configuration ───────────────────────────────────────────────
# Backend: "local" (default filesystem) or "s3" (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_MAX_FILE_SIZE_MB=15

# S3 Configuration (required only when STORAGE_BACKEND=s3)
# S3_BUCKET_NAME=aicte-flowops-documents
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=your_s3_access_key_id
# S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
# S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com

# ── Notifications & Background Scheduler ────────────────────────────────
# Controlled execution of statutory deadline monitoring and escalations
ENABLE_SCHEDULER=true
SCHEDULER_INTERVAL_MINUTES=15
DEFAULT_REMINDER_WINDOWS_DAYS=7,3,1
DEFAULT_ESCALATION_OVERDUE_DAYS=5

# ── AI Provider Configuration (Phase 9) ────────────────────────────────
AI_ENABLED=true
AI_PROVIDER=deterministic
# Options for AI_PROVIDER: deterministic, fallback, gemini, openai, mock
# AI_API_KEY=your_server_side_api_key_here
# AI_MODEL=gemini-1.5-flash
# AI_TEMPERATURE=0.2
# AI_TIMEOUT_SECONDS=15
# AI_MAX_TOKENS=1500
