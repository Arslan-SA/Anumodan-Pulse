# AICTE FlowOps Backend — Environment Variables Configuration
# Copy this file to .env and configure for your deployment environment.

# ── Cloud Database (Render PostgreSQL) ──────────────────────────────────
# Managed PostgreSQL connection string (supports postgresql:// and postgres:// auto-normalization).
# In production mode (APP_ENV=production), local database hosts (localhost/127.0.0.1) and SQLite are strictly rejected.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aicte_flowops

# ── Application Environment ─────────────────────────────────────────────
# Set to 'production' in deployed environments (disables debug, enforces 32+ char JWT secret,
# and enforces managed PostgreSQL + cloud S3 object storage).
APP_ENV=development
DEBUG=true

# ── CORS Settings ───────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (e.g. your Vercel frontend URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://aicte-flowops.vercel.app

# ── Server Binding ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Authentication / JWT ────────────────────────────────────────────────
# Must be at least 32 characters in production (auto-checked on startup)
JWT_SECRET_KEY=aicte-flowops-development-secret-key-at-least-32-chars-long-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Cloud Object Storage (AWS S3-Compatible) ────────────────────────────
# Storage backend: "s3" for cloud object storage (AWS S3, Cloudflare R2, MinIO, Wasabi)
# In production (APP_ENV=production), STORAGE_BACKEND must be set to "s3" (local filesystem is disabled).
STORAGE_BACKEND=s3
STORAGE_MAX_FILE_SIZE_MB=15

# Cloud S3 Bucket & Credentials (Server-side only — never exposed to client):
S3_BUCKET_NAME=aicte-flowops-documents
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=your_aws_or_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_aws_or_r2_secret_access_key
# S3_ENDPOINT_URL is optional; set for Cloudflare R2 (https://<account-id>.r2.cloudflarestorage.com) or MinIO
# S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com

# Local filesystem storage path (only active in development when STORAGE_BACKEND=local)
STORAGE_LOCAL_PATH=./storage/uploads

# ── Notifications & Background Scheduler ────────────────────────────────
# Controlled execution of statutory deadline monitoring and escalations
ENABLE_SCHEDULER=true
SCHEDULER_INTERVAL_MINUTES=15
DEFAULT_REMINDER_WINDOWS_DAYS=7,3,1
DEFAULT_ESCALATION_OVERDUE_DAYS=5

# ── AI Provider Configuration (Phase 9) ────────────────────────────────
AI_ENABLED=true
AI_PROVIDER=deterministic
# Options for AI_PROVIDER: deterministic, fallback, gemini, openai, mock
# AI_API_KEY=your_server_side_api_key_here
# AI_MODEL=gemini-1.5-flash
# AI_TEMPERATURE=0.2
# AI_TIMEOUT_SECONDS=15
# AI_MAX_TOKENS=1500
