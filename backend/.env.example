# AICTE FlowOps Backend — Environment Variables
# Copy this file to .env and fill in the values.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aicte_flowops

# Application settings
APP_ENV=development
DEBUG=true

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000

# Authentication / JWT
JWT_SECRET_KEY=aicte-flowops-development-secret-key-at-least-32-chars-long-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Provider Configuration (Phase 9)
AI_ENABLED=true
AI_PROVIDER=fallback
# AI_PROVIDER=gemini # Options: fallback, gemini, openai, mock
# AI_API_KEY=your_server_side_api_key_here
# AI_MODEL=gemini-1.5-flash
# AI_TEMPERATURE=0.2
# AI_TIMEOUT_SECONDS=15
# AI_MAX_TOKENS=1500

